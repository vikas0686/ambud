# openapi-typescript@7.13.0 declares a peerDependency of typescript@^5.x,
# but hasn't bumped that range for TypeScript 6 yet — it's a range lag,
# not a real incompatibility (verified: it generates and the output
# type-checks cleanly under our TS 6 toolchain — see web/README.md).
# Without this, `npm ci` (what CI and `make web-install` both run)
# fails outright on the peer conflict.
legacy-peer-deps=true
